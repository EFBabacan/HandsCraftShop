{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "katalog": {
        "ClusterId": "katalog",
        "Match": { "Path": "/katalog/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/katalog" } ]
      },
      "sepet": {
        "ClusterId": "sepet",
        "Match": { "Path": "/sepet/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/sepet" } ]
      },
      "siparis": {
        "ClusterId": "siparis",
        "Match": { "Path": "/siparis/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/siparis" } ]
      },
      "indirim": {
        "ClusterId": "indirim",
        "Match": { "Path": "/indirim/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/indirim" } ]
      },
      "odeme": {
        "ClusterId": "odeme",
        "Match": { "Path": "/odeme/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/odeme" } ]
      },
      "fotograf": {
        "ClusterId": "fotograf",
        "Match": { "Path": "/fotograf/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/fotograf" } ]
      }
    },
    "Clusters": {
      "katalog": {
        "Destinations": { "d1": { "Address": "http://localhost:7001/" } }
      },
      "sepet": {
        "Destinations": { "d1": { "Address": "http://localhost:7002/" } }
      },
      "siparis": {
        "Destinations": { "d1": { "Address": "http://localhost:7003/" } }
      },
      "indirim": {
        "Destinations": { "d1": { "Address": "http://localhost:7004/" } }
      },
      "odeme": {
        "Destinations": { "d1": { "Address": "http://localhost:7005/" } }
      },
      "fotograf": {
        "Destinations": { "d1": { "Address": "http://localhost:7006/" } }
      }
    }
  }
}
