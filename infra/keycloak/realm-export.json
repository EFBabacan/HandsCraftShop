{
  "realm": "handcraft",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 1800,
  "smtpServer": {
    "host": "mailhog",
    "port": "1025",
    "from": "noreply@handcraft.local",
    "fromDisplayName": "HandCraft Shop",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "roles": {
    "realm": [
      { "name": "customer", "description": "Musteri rolu" },
      { "name": "admin", "description": "Yonetici rolu" }
    ]
  },
  "groups": [],
  "clientScopes": [
    {
      "name": "roles-flat",
      "description": "Realm rollerini duz 'roles' claim'i olarak token'a basar",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm-roles-flat",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "username-flat",
      "description": "preferred_username claim'ini access token'a basar",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "preferred-username-flat",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "sub-flat",
      "description": "sub (user id) claim'ini garanti eder",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "subject-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "api-audiences",
      "description": "Web/Admin login token'ina tum API audience'larini basar (katalog, sepet, siparis, indirim, odeme, fotograf)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-katalog",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "katalog", "id.token.claim": "false", "access.token.claim": "true" }
        },
        {
          "name": "aud-sepet",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "sepet", "id.token.claim": "false", "access.token.claim": "true" }
        },
        {
          "name": "aud-siparis",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "siparis", "id.token.claim": "false", "access.token.claim": "true" }
        },
        {
          "name": "aud-indirim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "indirim", "id.token.claim": "false", "access.token.claim": "true" }
        },
        {
          "name": "aud-odeme",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "odeme", "id.token.claim": "false", "access.token.claim": "true" }
        },
        {
          "name": "aud-fotograf",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "fotograf", "id.token.claim": "false", "access.token.claim": "true" }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": ["roles-flat", "username-flat", "sub-flat", "api-audiences"],
  "clients": [
    {
      "clientId": "web",
      "name": "HandCraft Public Web (MVC)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "web-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5000/*"],
      "webOrigins": ["http://localhost:5000"],
      "protocolMappers": [
        {
          "name": "aud-web",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "web",
            "id.token.claim": "false",
            "access.token.claim": "true"
