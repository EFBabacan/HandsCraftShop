@model HandCraft.Admin.Models.KullaniciFormVm
@{
    ViewData["Title"] = "Kullanıcı Düzenle";
}

<h2>Kullanıcı Düzenle</h2>

<form asp-action="Duzenle" method="post" class="col-md-6">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="mb-2">
        <label class="form-label">Kullanıcı Adı</label>
        <input asp-for="KullaniciAdi" class="form-control" readonly />
        <div class="form-text">Kullanıcı adı değiştirilemez.</div>
    </div>
    <div class="mb-2"><label class="form-label">E-posta</label><input asp-for="Email" type="email" class="form-control" /></div>
    <div class="mb-2"><label class="form-label">Ad</label><input asp-for="Ad" class="form-control" /></div>
    <div class="mb-2"><label class="form-label">Soyad</label><input asp-for="Soyad" class="form-control" /></div>
    <div class="mb-2">
        <label class="form-label">Yeni Parola (boş bırakırsan değişmez)</label>
        <input asp-for="Parola" type="password" class="form-control" />
    </div>
    <div class="mb-2 form-check">
        <input asp-for="Aktif" class="form-check-input" type="checkbox" />
        <label class="form-check-label">Aktif</label>
    </div>
    <div class="mb-3">
        <label class="form-label d-block">Roller</label>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" name="roller" value="customer" id="rCustomer"
                   @(Model.Roller.Contains("customer") ? "checked" : "") />
            <label class="form-check-label" for="rCustomer">customer</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" name="roller" value="admin" id="rAdmin"
                   @(Model.Roller.Contains("admin") ? "checked" : "") />
            <label class="form-check-label" for="rAdmin">admin</label>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Güncelle</button>
    <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
</form>
