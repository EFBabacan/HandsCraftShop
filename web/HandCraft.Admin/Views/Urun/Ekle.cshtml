@model HandCraft.Admin.Models.UrunFormVm
@{
    ViewData["Title"] = "Yeni Ürün";
    var kategoriler = ViewBag.Kategoriler as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
}

<h2>Yeni Ürün</h2>

<form asp-action="Ekle" method="post" enctype="multipart/form-data" class="col-md-6">
    @Html.AntiForgeryToken()
    <div class="mb-2"><label class="form-label">Ad</label><input asp-for="Ad" class="form-control" required /></div>
    <div class="mb-2"><label class="form-label">Açıklama</label><textarea asp-for="Aciklama" class="form-control"></textarea></div>
    <div class="mb-2"><label class="form-label">Fiyat</label><input asp-for="Fiyat" type="number" step="0.01" class="form-control" required /></div>
    <div class="mb-2">
        <label class="form-label">Kategori</label>
        <select asp-for="KategoriId" asp-items="kategoriler" class="form-select" required>
            <option value="">-- Seçin --</option>
        </select>
    </div>
    <div class="mb-2"><label class="form-label">Stok</label><input asp-for="Stok" type="number" class="form-control" required /></div>
    <div class="mb-3"><label class="form-label">Görsel</label><input type="file" name="gorsel" accept="image/*" class="form-control" /></div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
</form>
