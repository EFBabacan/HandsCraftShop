@model List<HandCraft.Admin.Models.UrunVm>
@{
    ViewData["Title"] = "Ürünler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Ürünler</h2>
    <a class="btn btn-primary" asp-action="Ekle">+ Yeni Ürün</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr><th>Görsel</th><th>Ad</th><th>Kategori</th><th>Fiyat</th><th>Stok</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(u.ImageUrl))
                    {
                        <img src="@u.ImageUrl" style="width:48px;height:48px;object-fit:cover" class="rounded" />
                    }
                </td>
                <td>@u.Ad</td>
                <td>@u.KategoriAdi</td>
                <td>@u.Fiyat.ToString("N2") ₺</td>
                <td>@u.Stok</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Duzenle" asp-route-id="@u.Id">Düzenle</a>
                    <form asp-action="Sil" method="post" class="d-inline" onsubmit="return confirm('Silinsin mi?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@u.Id" />
                        <button class="btn btn-sm btn-outline-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
