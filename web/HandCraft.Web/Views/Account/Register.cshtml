@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h2 class="mb-3">Müşteri Kaydı</h2>

        @if (ViewBag.Hata is not null)
        {
            <div class="alert alert-danger">@ViewBag.Hata</div>
        }
        @if (ViewBag.Basarili is not null)
        {
            <div class="alert alert-success">
                @ViewBag.Basarili
                <a asp-controller="Account" asp-action="Login" class="alert-link">Giriş yap →</a>
            </div>
        }

        <form asp-controller="Account" asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-2"><label class="form-label">Kullanıcı Adı</label><input name="kullaniciAdi" class="form-control" required /></div>
            <div class="mb-2"><label class="form-label">E-posta</label><input name="email" type="email" class="form-control" /></div>
            <div class="mb-2"><label class="form-label">Ad</label><input name="ad" class="form-control" /></div>
            <div class="mb-2"><label class="form-label">Soyad</label><input name="soyad" class="form-control" /></div>
            <div class="mb-3"><label class="form-label">Parola</label><input name="parola" type="password" class="form-control" required /></div>
            <button type="submit" class="btn btn-primary w-100">Kayıt Ol</button>
        </form>
        <p class="mt-3 text-center text-muted">
            Zaten hesabın var mı? <a asp-controller="Account" asp-action="Login">Giriş yap</a>
        </p>
    </div>
</div>
