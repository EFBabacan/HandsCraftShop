@model List<HandCraft.Web.Models.UrunVm>
@{
    ViewData["Title"] = "Vitrin";
    var kategoriler = ViewBag.Kategoriler as List<HandCraft.Web.Models.KategoriVm> ?? new();
    var secili = ViewBag.SeciliKategori as string;
}

<div class="row mb-4">
    <div class="col">
        <h2>El Yapımı Ürünler</h2>
        <div class="btn-group flex-wrap" role="group">
            <a class="btn btn-sm @(string.IsNullOrEmpty(secili) ? "btn-dark" : "btn-outline-dark")"
               asp-controller="Home" asp-action="Index">Tümü</a>
            @foreach (var k in kategoriler)
            {
                <a class="btn btn-sm @(secili == k.Id ? "btn-dark" : "btn-outline-dark")"
                   asp-controller="Home" asp-action="Index" asp-route-kategoriId="@k.Id">@k.Ad</a>
            }
        </div>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
    @foreach (var urun in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                @if (!string.IsNullOrEmpty(urun.ImageUrl))
                {
                    <img src="@urun.ImageUrl" class="card-img-top" alt="@urun.Ad" style="height:180px;object-fit:cover" />
                }
                else
                {
                    <div class="bg-light d-flex align-items-center justify-content-center" style="height:180px">
                        <span class="text-muted">Görsel yok</span>
                    </div>
                }
                <div class="card-body d-flex flex-column">
                    <h6 class="card-title">@urun.Ad</h6>
                    <span class="badge bg-secondary align-self-start mb-2">@urun.KategoriAdi</span>
                    <p class="card-text small text-muted">@urun.Aciklama</p>
                    <div class="mt-auto d-flex justify-content-between align-items-center">
                        <strong>@urun.Fiyat.ToString("N2") ₺</strong>
                        <a class="btn btn-sm btn-outline-primary" asp-controller="Home" asp-action="Detay" asp-route-id="@urun.Id">İncele</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">Bu kategoride ürün bulunamadı.</p>
}
